<Window
    x:Class="Sudoku.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sudoku">

    <Grid Padding="24">
        <Grid.Background>
            <ImageBrush ImageSource="Assets/app-dark-background.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.Resources>
            <Style x:Key="NumberPadButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="Curlz MT"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <!-- Header + board + sidebar share one column grid so the header controls
             can align exactly with the board/sidebar below them. -->
        <Grid x:Name="ContentArea">
            <Grid x:Name="MainContent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0" Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="20"
                            Margin="0,0,0,8">
                    <TextBlock Text="Sudoku at Night"
                               FontFamily="Curlz MT"
                               FontSize="64"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="White"/>

                    <Image x:Name="TitleIcon"
                           Source="Assets/title-icon.png"
                           Width="80" Height="80"
                           VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Difficulty selector + new game: left-aligned in the sidebar column so
                     they line up with the timer card's left edge below -->
                <StackPanel Grid.Row="0" Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Margin="0,0,0,8">
                    <ComboBox x:Name="DifficultyComboBox"
                              Width="160"
                              Height="52"
                              FontFamily="Curlz MT"
                              FontSize="20"
                              SelectedIndex="1">
                        <ComboBoxItem Content="Easy"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Hard"/>
                        <ComboBoxItem Content="Expert"/>
                    </ComboBox>

                    <Button x:Name="NewGameButton"
                            Content="New Game"
                            Click="NewGameButton_Click"
                            Height="52"
                            Padding="28,8"
                            FontFamily="Curlz MT"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Background="{StaticResource AppAccentBrush}"
                            Foreground="{StaticResource AppAccentTextBrush}"/>
                </StackPanel>

                <!-- Board -->
                <Grid x:Name="BoardContainer" Grid.Row="1" Grid.Column="0">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="8"
                            CornerRadius="16"
                            BorderBrush="{StaticResource AppAccentBrush}"
                            BorderThickness="3"
                            Background="#FF1B1B24">

                        <Grid>
                            <Grid x:Name="BoardGrid"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 3x3 subgrid dividers: the 4 internal lines only -->
                                <Rectangle Grid.Row="0" Grid.RowSpan="9" Grid.Column="3" Width="3" HorizontalAlignment="Left" Fill="White"/>
                                <Rectangle Grid.Row="0" Grid.RowSpan="9" Grid.Column="6" Width="3" HorizontalAlignment="Left" Fill="White"/>
                                <Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="9" Height="3" VerticalAlignment="Top" Fill="White"/>
                                <Rectangle Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="9" Height="3" VerticalAlignment="Top" Fill="White"/>

                            </Grid>

                            <!-- Pause overlay: blocks board interaction while paused -->
                            <Border x:Name="PauseOverlay"
                                    Visibility="Collapsed"
                                    CornerRadius="12"
                                    Background="#FF1B1B24">
                                <TextBlock Text="Paused"
                                           FontFamily="Curlz MT"
                                           FontSize="48"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Sidebar -->
                <StackPanel x:Name="SidebarPanel"
                            Grid.Row="1" Grid.Column="2"
                            Width="220"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="20">

                    <!-- Timer -->
                    <Border CornerRadius="16"
                            Padding="4"
                            HorizontalAlignment="Center"
                            Background="#334B3DE0"
                            BorderBrush="{StaticResource AppAccentBrush}"
                            BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="TIME"
                                           FontFamily="Chiller"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TimerText"
                                           Text="00:00"
                                           FontFamily="Curlz MT"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Width="130"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="TimerMoonIcon"
                                   Source="Assets/half-moon-icon.png"
                                   Width="100" Height="100"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Number pad -->
                    <Grid x:Name="NumberPadGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="1" Tag="1" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="2" Tag="2" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="3" Tag="3" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="4" Tag="4" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Tag="5" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Tag="6" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="2" Grid.Column="0" Content="7" Tag="7" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="8" Tag="8" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="9" Tag="9" Click="NumberPad_Click" Style="{StaticResource NumberPadButtonStyle}"/>
                    </Grid>

                    <!-- Actions: Erase / Hint / Pause -->
                    <Grid x:Name="ActionButtonsGrid" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="EraseButton" Grid.Column="0"
                                Content="Erase"
                                Click="EraseButton_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10"
                                FontFamily="Chiller"
                                Background="Transparent"
                                BorderBrush="{StaticResource AppAccentBrush}"
                                BorderThickness="1.5"
                                Foreground="White"/>

                        <Button x:Name="HintButton" Grid.Column="1"
                                Content="Hint"
                                Click="HintButton_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10"
                                FontFamily="Chiller"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                BorderBrush="{StaticResource AppAccentBrush}"
                                BorderThickness="1.5"
                                Foreground="{StaticResource AppAccentTextBrush}"/>

                        <Button x:Name="PauseButton" Grid.Column="2"
                                Content="Pause"
                                Click="PauseButton_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10"
                                FontFamily="Chiller"
                                Background="Transparent"
                                BorderBrush="{StaticResource AppAccentBrush}"
                                BorderThickness="1.5"
                                Foreground="White"/>
                    </Grid>

                    <!-- Settings -->
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Click="SettingsButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,10"
                            FontFamily="Chiller"
                            Background="Transparent"
                            BorderBrush="{StaticResource AppAccentBrush}"
                            BorderThickness="1.5"
                            Foreground="White"/>

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

</Window>
